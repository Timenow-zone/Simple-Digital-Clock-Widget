{
  "name": "simple-digital-clock-widget",
  "version": "0.7.2",
  "description": "Simple Digital Clock Widget – a lightweight HTML/JS digital clock widget with flexible settings, embedded seamlessly for your website. Build ⚡ instantly-interactive web widget without effort.",
  "author": {
    "name": "dejurin",
    "url": "https://github.com/Timenow-zone"
  },
  "license": "MIT",
  "homepage": "https://utctime.info/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timenow-zone/Simple-Digital-Clock-Widget.git"
  },
  "bugs": {
    "url": "https://github.com/Timenow-zone/Simple-Digital-Clock-Widget/issues"
  },
  "funding": [
    {
      "type": "website",
      "url": "https://utctime.info/"
    },
    {
      "type": "website",
      "url": "https://todaysdatenow.com/"
    }
  ],
  "keywords": [
    "digital-clock",
    "clock-widget",
    "web-component",
    "preact",
    "custom-element",
    "utc",
    "time-zone"
  ],
  "scripts": {
    "build": "parcel build src/SimpleDigitalClockWidget.tsx --no-optimize && terser dist/SimpleDigitalClockWidget.js -c -m -o dist/latest.min.js && cp dist/latest.min.js dist/$npm_package_version.min.js",
    "build:prod": "parcel build src/SimpleDigitalClockWidget.tsx",
    "start": "parcel src/index.html --open",
    "fmt": "prettier --write **/*.{ts,tsx,js,json,css,html}",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "test:manual": "python3 -m http.server 4173",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "pretest:node": "rm -rf .tmp-tests && tsc -p tsconfig.test.json",
    "test:node": "node --test './.tmp-tests/**/*.spec.js' './.tmp-tests/**/*.test.js'",
    "pretest:browsers": "rm -rf .tmp-web && tsc -p tsconfig.wtr.json",
    "test:browsers": "web-test-runner \".tmp-web/tests/**/*.browser.spec.js\" --root-dir ./.tmp-web --config wtr.config.mjs --playwright --browsers chromium firefox webkit && npm run test:iframes",
    "test:iframes": "node --test tests/iframe-resize.integration.test.mjs",
    "coverage": "c8 -r text -r html --exclude 'tests/**' --exclude '.tmp-tests/tests/**' npm run test:node",
    "release:sync": "node scripts/sync-release-metadata.mjs --sync",
    "release:check": "node scripts/sync-release-metadata.mjs --check && node scripts/build-product-site.mjs --check",
    "release:artifacts": "node scripts/sync-release-metadata.mjs --artifacts",
    "release:verify": "node scripts/sync-release-metadata.mjs --verify-versioned",
    "release:version": "node scripts/sync-release-metadata.mjs --version",
    "site:build": "node scripts/build-product-site.mjs --build",
    "site:check": "node scripts/build-product-site.mjs --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "preact": "11.1.0",
    "preact-custom-element": "^4.6.0"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@parcel/config-default": "^2.16.4",
    "@parcel/transformer-inline-string": "2.16.4",
    "@parcel/transformer-yaml": "2.16.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "c8": "^10.1.3",
    "eslint": "^9.35.0",
    "eslint-config-preact": "^2.0.0",
    "eslint-plugin-react": "^7.37.5",
    "parcel": "^2.16.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.50.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.155.0"
  },
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true,
      "distDir": "./dist",
      "isLibrary": false,
      "engines": {
        "browsers": "> 0.25%, not dead",
        "node": ">= 12"
      },
      "optimize": false
    }
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "engines": {
    "node": ">=22"
  }
}
