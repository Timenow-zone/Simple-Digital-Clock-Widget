{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],

    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",

    "strict": true,
    "moduleResolution": "bundler",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": [
    "src/**/*",
    "parcel.d.ts",
    "declarations.d.ts"
  ],

  "exclude": [
    "node_modules",
    ".parcel-cache",
    ".tmp-tests",
    ".tmp-web",
    "dist"
  ]
}
