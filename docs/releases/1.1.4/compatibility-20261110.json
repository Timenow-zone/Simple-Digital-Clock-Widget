  "beta_caveats": [
    {
      "id": "core-attribute-order",
      "description": "Core KSES sorts the single custom-element opening-tag attributes on restricted-role save. Independent lexical proof confirms only order changed, with no duplicates, exact values, exact bytes outside the tag and exact JSON comments on both PHP versions. Repeated save is byte-idempotent; strict hard-caption corpus guards were not relaxed.",
      "evidence": ".local/compatibility-20261110/review/beta5-final-role-save-proof.json"
    },
    {
      "id": "core-webkit-prefetch",
      "description": "Fast navigation away from Core login/dashboard triggers WebKit access-control page errors in the new Core asset-prefetch fallback even with the plugin deactivated. A/B: plugin OFF fast 19 / settled 0; ON fast 20 / settled 0. Waiting for load, scheduled idle and networkidle before leaving resolves the observed cancellation race. Full i18n rerun retains pageerror=[] and all original content/security assertions; no errors were filtered. This is a documented Core/WebKit fast-navigation limitation.",
      "evidence": ".local/compatibility-20261110/wp72/diagnostics/webkit-editor-ready-results.json"
    },
    {
      "id": "core-navigation-bootstrap",
      "description": "First block-theme frontend requests create one Core wp_navigation fallback post on each PHP. Existing posts, options and plugin files remain byte-exact. The complete 180-case browser suite was repeated after bootstrap with strict whole-posts/options equality.",
      "evidence": ".local/compatibility-20261110/wp72/diagnostics/core-navigation-bootstrap.json"
    },
    {
      "id": "inherited-pcp-label",
      "description": "The baseline raw summary retains a stale minimum skip label referencing PHP7.0.33. Actual minimum is PHP8.3.35; a separate actual Plugin Check execution covers all 29 static and 5 runtime checks with zero findings. The raw receipt was not rewritten.",
